{
  "name": "mdv-desktop-renderer",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "Bundled, offline Markdown renderer for the MDV Windows desktop application",
  "scripts": {
    "build": "node scripts/build-renderer.mjs",
    "test": "node --test renderer/test/*.test.mjs scripts/compatibility/*.test.mjs",
    "compat:html": "node scripts/compatibility/html.mjs",
    "compat:check": "node scripts/compatibility/html.mjs --check",
    "compat:baseline": "node scripts/compatibility/html.mjs --record-baseline",
    "compat:math": "node scripts/compatibility/browser.mjs --kind math --check",
    "compat:browser": "node scripts/compatibility/browser.mjs",
    "upstream:setup": "node scripts/upstream/setup.mjs",
    "upstream:render": "node scripts/upstream/render.mjs",
    "upstream:check": "node scripts/upstream/compare.mjs",
    "upstream:preview": "node scripts/upstream/preview.mjs",
    "upstream:test": "node --test tests/upstream/engine.test.mjs",
    "upstream:test:browser": "node scripts/upstream/browser-test.mjs",
    "upstream:stages": "node scripts/upstream/stages.mjs",
    "test:browser": "playwright test",
    "check": "npm test && npm run compat:check && npm run build && npm run test:browser",
    "upstream:service": "node scripts/upstream/service-check.mjs",
    "test:editions": "node scripts/test-editions.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@github/clipboard-copy-element": "1.3.2",
    "@primer/css": "22.3.2",
    "@primer/octicons": "19.40.0",
    "@primer/primitives": "11.10.0",
    "dompurify": "3.4.16",
    "gemoji": "8.1.0",
    "github-slugger": "2.0.0",
    "highlight.js": "11.12.0",
    "mathjax": "3.2.2",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.1.0",
    "mermaid-qiita": "npm:mermaid@11.12.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-breaks": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-css": "0.25.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-jsdoc": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "cson-parser": "4.0.9",
    "esbuild": "0.28.2",
    "pngjs": "7.0.0"
  }
}
