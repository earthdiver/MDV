<Project>
  <PropertyGroup>
    <MdvEdition Condition="'$(MdvEdition)' == ''">dual</MdvEdition>
    <DefineConstants Condition="'$(MdvEdition)' == 'custom'">$(DefineConstants);MDV_CUSTOM</DefineConstants>
    <DefineConstants Condition="'$(MdvEdition)' == 'upstream'">$(DefineConstants);MDV_UPSTREAM</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
